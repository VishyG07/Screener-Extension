{
  "manifest_version": 3,
  "name": "Screener.in Native Scraper",
  "version": "2.0.8",
  "icons": {
    "128": "icon_128.png"
  },
  "description": "All-in-One Screener Extension: New Tab Dashboard, Side Panel, and Ticker Tape.",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.screener.in/*",
    "*://*.yahoo.com/*",
    "*://news.google.com/*"
  ],
  "action": {
    "default_title": "Open Screener Watchlist"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open Screener Side Panel"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ticker_tape.js",
        "floating_widget.js"
      ],
      "css": [
        "ticker_tape.css",
        "floating_widget.css"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}